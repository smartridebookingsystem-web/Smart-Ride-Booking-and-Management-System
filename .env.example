# ==========================================
# SMART RIDE BOOKING SYSTEM - ENVIRONMENT VARIABLES EXAMPLE
# ==========================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env with real secrets to Git.

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=p03_srbms
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# Spring Microservice Database Credentials
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/p03_srbms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Microservice Ports
GATEWAY_PORT=8088
AUTH_SERVICE_PORT=8081
RIDE_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
EUREKA_PORT=8761
AI_SERVICE_PORT=8084

# Frontend Application Ports
FRONTEND_ADMIN_PORT=5173
FRONTEND_DRIVER_PORT=5174
FRONTEND_RIDER_PORT=5175

# Service Discovery & Gateway Configuration
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
VITE_API_URL=http://localhost:8088

# Security Credentials & JWT Secret Token
# Must be a BASE64-encoded HS256 key (at least 256 bits)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# ==========================================
# GOOGLE GEMINI AI CONFIGURATION
# ==========================================
# Required for the SmartRide AI chatbot (smartride-ai-service)
# Get your free API key at: https://aistudio.google.com/app/apikey
#
# SECURITY RULES:
#   - NEVER hardcode this key in Java source code
#   - NEVER commit this file with a real key to Git
#   - This key stays ONLY on the backend — never exposed to React
#   - Set as environment variable or in .env (which is in .gitignore)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio SMS Gateway Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# OpenRouteService API Key (Map Routing)
VITE_OPENROUTE_API_KEY=your_openroute_api_key_here
